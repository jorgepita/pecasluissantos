# Copy this file to .env.local and fill in your Supabase project's PUBLIC
# credentials (Project Settings > API in the Supabase dashboard).
#
# These are safe to expose in client-side code: Supabase's anon key is
# meant to be public and relies on Row Level Security (RLS) policies for
# protection, not secrecy. See docs/DATABASE.md.
#
# NEVER put a service_role key, database password, or any other privileged
# credential in a VITE_-prefixed variable (or anywhere in this repo) —
# VITE_ variables are bundled into the client-side JavaScript and are
# publicly readable by anyone who visits the site.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
